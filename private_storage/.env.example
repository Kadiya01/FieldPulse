# =============================================================================
# FieldPulse — environment template
#
# Copy to `.env`, fill in, then `chmod 640 .env`.
# The .env FILE is authoritative; real environment variables are consulted only
# for keys this file omits. Never commit the real .env.
# =============================================================================

APP_ENV=production
APP_DEBUG=false
APP_NAME=FieldPulse
# Public origin. Used for absolute URLs in the PWA and to enforce Origin checks.
APP_URL=https://example.com

# Business/reporting timezone. Weekly periods start Monday 00:00:00 here.
# All stored DATETIME values remain UTC regardless of this setting.
APP_TIMEZONE=Africa/Lagos

# Extra trusted origins, comma separated, for the CSRF check on mutating requests.
# APP_URL is always trusted implicitly. Leave empty unless the PWA is served from
# a different origin than the API.
ALLOWED_ORIGINS=

# Set to true ONLY if FieldPulse genuinely sits behind a proxy that overwrites
# X-Forwarded-For and X-Forwarded-Proto. On a bare cPanel host leave this false:
# an unvalidated X-Forwarded-For is attacker-controlled and feeds both the audit
# log and the rate limiter.
TRUST_PROXY_HEADERS=false

# -----------------------------------------------------------------------------
# Database (cPanel: prefix with your cPanel user, e.g. cpaneluser_fieldpulse)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fieldpulse
DB_USER=fieldpulse
DB_PASSWORD=
# Set when MySQL is on a unix socket (common on cPanel); wins over host/port.
DB_SOCKET=

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
# Generate with:  php -r "echo bin2hex(random_bytes(48)), PHP_EOL;"
# Must be at least 32 bytes. The app refuses to boot without it.
JWT_SECRET=
JWT_ISSUER=fieldpulse
JWT_AUDIENCE=fieldpulse-pwa

# -----------------------------------------------------------------------------
# Token lifecycle
# -----------------------------------------------------------------------------
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=fp_refresh

# -----------------------------------------------------------------------------
# Device request authentication (§7)
# -----------------------------------------------------------------------------
CLOCK_SKEW_SECONDS=300
NONCE_TTL_SECONDS=900
CHALLENGE_TTL_SECONDS=300

# Lifetime of the operator-issued one-time device pairing code. Keep this short:
# the code is the only factor standing between a known IMEI and a bound device
# key, so it should be useless within the time it takes to walk to a handset.
PAIRING_CODE_TTL_SECONDS=1800

# -----------------------------------------------------------------------------
# Abuse control (zero-password IMEI model)
# -----------------------------------------------------------------------------
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=900
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW=3600

# -----------------------------------------------------------------------------
# Upload limits (§10: 5 MB hard ceiling)
# -----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
MIN_IMAGE_DIMENSION=64
MAX_IMAGE_DIMENSION=12000
MAX_IMAGE_PIXELS=40000000

# -----------------------------------------------------------------------------
# Perceptual duplicate detection (§11)
# -----------------------------------------------------------------------------
PHASH_HAMMING_THRESHOLD=8
PHASH_POSSIBLE_MARGIN=4
PHASH_CANDIDATE_LIMIT=500

# -----------------------------------------------------------------------------
# Geofencing (§12)
# -----------------------------------------------------------------------------
GEOFENCE_DEFAULT_RADIUS_M=250
GEOFENCE_BBOX_PADDING_M=500
GPS_ACCURACY_TOLERANCE_M=100

# -----------------------------------------------------------------------------
# Timestamp plausibility
# -----------------------------------------------------------------------------
TS_MAX_FUTURE_SKEW=900
TS_MAX_PAST_SKEW=604800

# -----------------------------------------------------------------------------
# Claim volume policy
# -----------------------------------------------------------------------------
COUNT_CLAIMED_MIN=1
COUNT_CLAIMED_MAX=500
WEEKLY_CAP=2500

# -----------------------------------------------------------------------------
# Queue worker (cPanel cron: every minute)
# -----------------------------------------------------------------------------
JOB_MAX_ATTEMPTS=5
JOB_LOCK_TIMEOUT_MIN=10
JOB_BATCH_SIZE=10
WORKER_MAX_RUNTIME=240

# Stamped onto every verified row so a disposition can be traced to the rule
# set that produced it. Bump when thresholds change.
VERIFICATION_VERSION=v1.0.0

# -----------------------------------------------------------------------------
# Operations
# -----------------------------------------------------------------------------
# Days to keep completed job rows for forensics before bin/prune.php removes them.
JOB_RETENTION_DAYS=7
# Days of audit history to retain. This is the only independent record of who
# reviewed what, so it is deliberately long.
AUDIT_RETENTION_DAYS=730
# Days of failed-login history to keep for rate limiting.
LOGIN_ATTEMPT_RETENTION_DAYS=30
