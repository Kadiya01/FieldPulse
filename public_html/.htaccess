# ---------------------------------------------------------------------------
# FieldPulse — document root lockdown
#
# Everything that matters lives in ../private_storage, outside this directory.
# This file's job is to make sure nothing outside public_html can be reached
# even if the directory above it is a symlink, a misconfigured alias, or an
# add-domain that points one level too high.
#
# Order of precedence in Apache: <Files> sections are merged after the main
# server/directory config, and within a merge the FIRST matching section wins.
# The Allow rules below are therefore deliberately written before the deny
# sections, so a .php file is granted before the dotfile rule can consider it.
# ---------------------------------------------------------------------------

<IfModule mod_authz_core.c>
    # Nothing in this tree should be listable. A directory index here would
    # advertise the exact endpoint names an attacker should be probing.
    Options -Indexes
    Options +SymLinksIfOwnerMatch
</IfModule>

# The PWA shell. Stated explicitly rather than inherited: `Options -Indexes`
# removes the generated listing, and relying on the server's inherited
# DirectoryIndex to still pick up index.html is one config change away from the
# root URL serving a 403.
<IfModule mod_dir.c>
    DirectoryIndex index.html
</IfModule>

# --- Grant first: our entry points are .php files ----------------------------
<FilesMatch "\.php$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# --- Then deny: dotfiles and editor debris -----------------------------------
# Deliberately does NOT match "\." anywhere in the name. A broad "contains a dot"
# pattern also matches submit.php and would take the entire API offline. This
# targets a leading dot, a known editor backup extension, or a trailing tilde.
<FilesMatch "(^\.)|~$|\.(bak|old|orig|save|swp|swo|dist|log|sql|ini|conf|env|yml|yaml|jsonl)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- CGI handlers are never legitimate here ----------------------------------
<IfModule mod_alias.c>
    RedirectMatch 404 ^/(cgi-bin|wp-admin|wp-login|xmlrpc\.php)
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Any request whose final path segment begins with a dot is a probe for
    # .env, .git, .htpasswd. Denied outright, including for well-known, which
    # is not something this application serves.
    RewriteRule (^|/)\. - [F,L]

    # Deny request for any file that is not one of the known-good suffixes. This
    # is an allowlist, so a newly added file type is inert until it is declared
    # here, rather than live the moment it is uploaded.
    #
    # Every suffix test below reads %{REQUEST_FILENAME}, and that choice is load
    # bearing. It is the resolved on-disk path: it never carries a query string,
    # and it is never affected by whether an earlier RewriteCond captured a
    # backreference.
    #
    # The previous version captured the path into %1 with
    # `RewriteCond %{REQUEST_URI} ^([^?]*)(\?.*)?$` and tested %1 in the
    # conditions below. That was verified broken on Apache 2.4.55: the negated
    # condition `RewriteCond %1 !\.(html|...)$ [NC]` evaluated as though %1 were
    # empty, so every request for a file with a real extension was answered 403
    # — including /index.html, every hashed asset, and every API entry point. The
    # whole site was offline and nothing in the repository could see it, because
    # the file is only ever read by an Apache that was never running. The same
    # capture fed the SPA fallback below, so its "is this /api/?" and "is this
    # extensionless?" tests were equally unreliable.
    #
    # Do not reintroduce a cross-condition capture here. bin/deploy_test.php
    # asserts these rules against a real Apache and is the only thing standing
    # between a working document root and a silently dead one.

    # Only enforce the allowlist against a path segment that actually names a
    # file. An extensionless path is a client-side React Router route (/queue,
    # /login, /leaderboard), not a file, so it has no suffix to allowlist --
    # testing it as one returned 403 for every deep link on a deployed host,
    # while `vite dev` served the same URLs happily.
    RewriteCond %{REQUEST_FILENAME} \.[A-Za-z0-9]+$
    RewriteCond %{REQUEST_FILENAME} !\.(php|js|mjs|css|map|json|webmanifest|html|txt|ico|png|jpg|jpeg|gif|svg|webp|woff2?|ttf|eot)$ [NC]
    RewriteRule ^ - [F,L]

    # Nothing under api/ may ever be answered with the SPA shell. This short
    # circuit runs before the fallback and matches the per-directory path, so it
    # also holds when the app is installed in a subdirectory (/app/api/...), which
    # a %{REQUEST_URI} prefix test would not cover.
    RewriteRule ^api/ - [L]

    # SPA fallback: serve the built shell for a client-side route.
    #
    # Restricted to extensionless paths on purpose. Rewriting *any* unmatched
    # request would answer a missing chunk request (say a stale
    # /assets/index-abc123.js) with 200 and a page of HTML, which the service
    # worker and the browser would both have to diagnose. A missing asset should
    # stay a 404. API paths are excluded above so a renamed or missing endpoint
    # keeps returning the API's own 404 rather than a 200 of HTML that a client
    # would try to parse as JSON.
    RewriteCond %{REQUEST_FILENAME} !\.[A-Za-z0-9]+$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /index.html [L]
</IfModule>

# --- Caching for the PWA shell -----------------------------------------------
# The build content-hashes these assets, so a long max-age is safe: a new deploy
# changes the filename, which is exactly what a cache-busting URL is for.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css          "access plus 1 year"
    ExpiresByType image/webp        "access plus 6 months"
    ExpiresByType image/svg+xml     "access plus 6 months"
    ExpiresByType font/woff2        "access plus 1 year"
</IfModule>

# --- Security headers --------------------------------------------------------
# The API is JSON-only and consumed by a PWA, so the policy is tight: no
# framing, no content sniffing, no referrer leakage. Permissions-Policy grants
# only the two device APIs the app actually uses — camera for the capture screen,
# geolocation for the submission payload — and nothing else.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=(), usb=()"

    # Content-Security-Policy, no 'unsafe-inline' and no 'unsafe-eval'.
    #
    # The built shell ships zero inline <script> and zero inline <style> (Vite
    # emits external module scripts and an external stylesheet; registerSW.js is
    # an external file), and the bundle contains no eval/new Function, so none of
    # the usual escape hatches are needed. That is a property of the build, not
    # a guess: `npm run build` then `grep -c 'eval(\|new Function' dist/assets/*.js`
    # has to stay at 0, and deploy_test.php re-checks it on every deploy, because
    # a dev-only eval() or a styled-components style block would start violating
    # this policy in production where nothing would announce it.
    #
    # blob: appears in img-src/media-src for the camera preview, which is a local
    # FileReader stream and never leaves the device. worker-src keeps blob: for
    # the service worker's runtime importScripts. manifest-src is separate from
    # script-src because a manifest is fetched as a manifest, not a script.
    #
    # upgrade-insecure-requests assumes a working certificate. The app already
    # requires one (APP_URL is https, the refresh cookie is Secure, and HSTS
    # below pins the host), so it is consistent — but on a host with no
    # certificate at all this directive rewrites every same-origin request to
    # https and the app fails closed rather than silently running in plaintext.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"

    # Send the Strict-Transport-Security header as soon as the certificate is
    # live. Set it here rather than relying on the operator, but note it does
    # nothing until TLS terminates on this vhost. Emitted unconditionally on
    # purpose: gating it on %{HTTPS} would silently drop the header when TLS
    # terminates upstream in a proxy the operator forgot to declare via
    # TRUST_PROXY_HEADERS, and a browser ignores HSTS received over plain HTTP
    # in any case, so sending it on both is correct rather than sloppy.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # The service worker must never be served from cache, or a deploy cannot
    # take over a stale worker. index.html is cached no-store for the same
    # reason: it names the content-hashed asset URLs, so a cached copy pins the
    # client to the previous build.
    <FilesMatch "\.(html|webmanifest)$">
        Header always set Cache-Control "no-store, must-revalidate"
    </FilesMatch>
    <FilesMatch "^sw\.js$">
        Header always set Cache-Control "no-store, must-revalidate"
        Header always set Service-Worker-Allowed "/"
    </FilesMatch>

    # Remove the stack fingerprint. Free recon for an attacker.
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# ---------------------------------------------------------------------------
# Not configured here, and deliberately so:
#
#   php_flag engine off   would disable PHP for api/ as well, since it applies
#                         to the directory and inherits into subdirectories. The
#                         real defence against an uploaded .php file executing is
#                         structural: no directory inside public_html is ever
#                         writable by the web user. Uploads are written to
#                         ../private_storage/fieldpulse/quarantine by the PHP CLI
#                         or web user, never to a public path.
#
#   ServerSignature Off   only valid in server or virtualhost config, not in
#                         .htaccess, where it causes a 500. Ask the operator to
#                         set it, or ignore it.
# ---------------------------------------------------------------------------
